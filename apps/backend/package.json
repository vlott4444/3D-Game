{
  "private": true,
  "name": "@3d-game/backend",
  "version": "0.1.0",
  "description": "Colyseus server",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000",
    "typecheck": "tsc --noEmit",
    "agent:chat": "tsx src/agents/scripts/chat.ts",
    "serve": "node build/index.js"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "@types/node": "^22.19.0"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "bcrypt": "^6.0.0",
    "colyseus": "^0.18.2",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "exports": {
    "./*": "./src/*.ts"
  }
}
