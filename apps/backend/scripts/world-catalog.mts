import { readFileSync, writeFileSync, readdirSync, statSync } from "node:fs";
import { createHash } from "node:crypto";
import { fileURLToPath } from "node:url";
import { resolve, relative } from "node:path";
import {
  generateChunk,
  MIN_CHUNK,
  MAX_CHUNK,
  WORLD_MIN,
  WORLD_MAX,
} from "../src/world/TerrainGenerator.js";
const root = fileURLToPath(new URL("../../../", import.meta.url));
const frontend = resolve(root, "apps/frontend");
const hash = (s: Buffer | string) => createHash("sha256").update(s).digest("hex");
// Directory order and locale collation differ between Windows and Linux.
const compare = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
function files(dir: string): string[] {
  return readdirSync(dir)
    .sort(compare)
    .flatMap((n) => {
      const p = resolve(dir, n);
      return statSync(p).isDirectory() ? files(p) : [p];
    });
}
const assets = files(resolve(frontend, "public/models"))
  .map((p) => {
    const bytes = readFileSync(p);
    return {
      url:
        "/models/" +
        relative(resolve(frontend, "public/models"), p).replaceAll("\\", "/"),
      bytes: bytes.length,
      sha256: hash(bytes),
    };
  })
  .sort((a, b) => compare(a.url, b.url));
// Source geometry definitions count as common world data as well, even though Vite also bundles them.
const definitions = files(resolve(frontend, "src/game"))
  .filter(
    (p) =>
      /\.(ts|tsx)$/.test(p) &&
      !p.endsWith("PlayerController.tsx") &&
      !p.endsWith("FollowCamera.tsx"),
  )
  .map((p) => {
    const bytes = Buffer.from(readFileSync(p, "utf8").replace(/\r\n/g, "\n"));
    return {
      path: relative(root, p).replaceAll("\\", "/"),
      bytes: bytes.length,
      sha256: hash(bytes),
    };
  })
  .sort((a, b) => compare(a.path, b.path));
let chunkBytes = 0,
  maxWindowBytes = 0;
const sizes = new Map<string, number>(),
  catalog = createHash("sha256");
for (let cx = MIN_CHUNK; cx <= MAX_CHUNK; cx++)
  for (let cz = MIN_CHUNK; cz <= MAX_CHUNK; cz++) {
    const value = JSON.stringify(generateChunk(cx, cz)),
      size = Buffer.byteLength(value);
    chunkBytes += size;
    catalog.update(value);
    sizes.set(`${cx}:${cz}`, size);
  }
for (let cx = MIN_CHUNK; cx <= MAX_CHUNK; cx++)
  for (let cz = MIN_CHUNK; cz <= MAX_CHUNK; cz++) {
    let size = 0;
    for (let x = -1; x <= 1; x++)
      for (let z = -1; z <= 1; z++) size += sizes.get(`${cx + x}:${cz + z}`) || 0;
    maxWindowBytes = Math.max(maxWindowBytes, size);
  }
const commonBytes =
  assets.reduce((n, a) => n + a.bytes, 0) + definitions.reduce((n, a) => n + a.bytes, 0);
const totalBytes = commonBytes + chunkBytes,
  budgetBytes = Math.floor(totalBytes / 10),
  dynamicReserve = 1024 * 1024;
// Reserve covers 3 serialized copies of all current dynamic messages, plus local geometry metadata.
if (commonBytes + dynamicReserve + 2 * (maxWindowBytes + 65536) > budgetBytes)
  throw Error(
    "Common assets and snapshots exceed 10%; reduce assets or revise the real map",
  );
const base = {
  version: 1,
  bounds: { min: WORLD_MIN, max: WORLD_MAX },
  chunkCount: (MAX_CHUNK - MIN_CHUNK + 1) ** 2,
  chunkBytes,
  commonBytes,
  totalBytes,
  budgetBytes,
  dynamicReserve,
  maxWindowBytes,
  terrainHash: catalog.digest("hex"),
  assets,
  definitions,
};
const value = { ...base, id: hash(JSON.stringify(base)) };
const output =
  "// Generated by scripts/world-catalog.mts. Do not edit by hand.\nexport const WORLD_CATALOG = " +
  JSON.stringify(value, null, 2) +
  " as const;\n";
const targets = [
  resolve(root, "apps/backend/src/world/WorldCatalog.generated.ts"),
  resolve(frontend, "src/network/WorldCatalog.generated.ts"),
];
for (const target of targets) {
  if (process.argv.includes("--check")) {
    if (readFileSync(target, "utf8").replace(/\r\n/g, "\n") !== output)
      throw Error("World manifest is stale. Run npm run world:catalog -w apps/backend");
  } else writeFileSync(target, output);
}
console.log(
  JSON.stringify({
    chunks: value.chunkCount,
    totalBytes,
    budgetBytes,
    commonBytes,
    maxWindowBytes,
    worstBudgetedRatio:
      (commonBytes + dynamicReserve + 2 * (maxWindowBytes + 65536)) / totalBytes,
  }),
);
