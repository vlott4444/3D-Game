{
  "name": "3d-game",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm start -w apps/backend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,mjs,cjs,json,css}\" \"*.json\" \".vscode/*.json\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,mjs,cjs,json,css}\" \"*.json\" \".vscode/*.json\""
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "version": "0.1.0",
  "description": "A Colyseus multiplayer server",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "prettier": "3.9.10"
  },
  "overrides": {
    "uWebSockets.js": "https://codeload.github.com/uNetworking/uWebSockets.js/tar.gz/cfc9a40d8132a34881813cec3d5f8e3a185b3ce3"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0"
  }
}
